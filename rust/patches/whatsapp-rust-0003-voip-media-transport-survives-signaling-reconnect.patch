From bb8481ed28790b5249ca0114aa8b6d20a88c3f6c Mon Sep 17 00:00:00 2001
From: fenleon <fenleon@users.noreply.github.com>
Date: Tue, 13 Oct 2026 22:18:28 +0200
Subject: [PATCH] voip: keep the media transport alive across a transient
 signaling reconnect

The run loop's disconnect cleanup (cleanup_connection_state_inner) unconditionally
aborted every in-flight call, so a ~1 s signaling-WS blip closed the per-call
media relay socket (net_conn) while the loop was about to reconnect under it.
Gate the voip teardown (abort_all + drain_pending_outgoing_on_disconnect) on the
disconnect being terminal: unexpected read-loop exit AND is_running AND
enable_auto_reconnect. Expected exits (reconnect()/reconnect_immediately(),
unused mid-call by wa-bridge) and every terminal path keep the reaping contract.
Also fix the two stale CallAction::Offer test initializers that broke the
--features voip lib-test compile, and the stale abort_all doc comment.
---
 src/client/lifecycle.rs     |  94 +++++++++++++++---
 src/voip/facade.rs          | 183 +++++++++++++++++++++++++++++++++++-
 wacore/src/voip/registry.rs |   4 +-
 3 files changed, 265 insertions(+), 16 deletions(-)

diff --git a/src/client/lifecycle.rs b/src/client/lifecycle.rs
index 0a8c9fad..2e7208f2 100644
--- a/src/client/lifecycle.rs
+++ b/src/client/lifecycle.rs
@@ -626,7 +626,16 @@ impl Client {
                     }
                 };
 
-                self.cleanup_connection_state().await;
+                // The voip teardown inside cleanup is gated on this classification: a genuine
+                // transport blip (unexpected exit, still running, auto-reconnect on) keeps
+                // in-flight calls alive — the media relay socket is per-call and independent of
+                // the signaling WS, and the loop below reconnects under it. Expected exits
+                // (`reconnect()` / `reconnect_immediately()` — conceptually transient too, but
+                // wa-bridge never calls them mid-call) and every terminal path keep today's
+                // reaping contract; see `cleanup_connection_state_on_transport_loss`.
+                let unexpected = unexpected_disconnect.is_some();
+                self.cleanup_connection_state_on_transport_loss(unexpected)
+                    .await;
 
                 // Dispatch after cleanup so handlers see cleared connection state.
                 if let Some(reason) = unexpected_disconnect {
@@ -1049,7 +1058,41 @@ impl Client {
     )]
     #[cfg(not(feature = "client-lifecycle"))]
     pub(crate) async fn cleanup_connection_state(self: &Arc<Self>) {
-        self.cleanup_connection_state_inner().await;
+        self.cleanup_connection_state_with_voip_policy(false).await;
+    }
+
+    /// The run loop's cleanup variant: classifies the read-loop exit and skips the voip teardown
+    /// on a transient transport blip. See
+    /// [`cleanup_connection_state_with_voip_policy`](Self::cleanup_connection_state_with_voip_policy).
+    ///
+    /// Classification (all three terms required — Task 1 findings):
+    /// - `unexpected_disconnect`: `reconnect()`/`reconnect_immediately()` funnel here classified
+    ///   `Expected` → `false`. They are conceptually transient, but wa-bridge never calls them
+    ///   mid-call, so their conservative teardown contract is preserved.
+    /// - `is_running`: false once `Client::disconnect()` ran (or during shutdown), making that
+    ///   path terminal.
+    /// - `enable_auto_reconnect`: an unexpected exit with reconnect disabled reaches this cleanup
+    ///   with `is_running` still true (the loop breaks only after cleanup); without this term the
+    ///   terminal exit would be misclassified transient and leak the call's registry entry and
+    ///   relay socket past a dead signaling session.
+    #[cfg(not(feature = "client-lifecycle"))]
+    pub(crate) async fn cleanup_connection_state_on_transport_loss(
+        self: &Arc<Self>,
+        unexpected_disconnect: bool,
+    ) {
+        let keep_voip_calls = unexpected_disconnect
+            && self.is_running.load(Ordering::Relaxed)
+            && self.enable_auto_reconnect.load(Ordering::Relaxed);
+        self.cleanup_connection_state_with_voip_policy(keep_voip_calls)
+            .await;
+    }
+
+    #[cfg(not(feature = "client-lifecycle"))]
+    pub(crate) async fn cleanup_connection_state_with_voip_policy(
+        self: &Arc<Self>,
+        keep_voip_calls: bool,
+    ) {
+        self.cleanup_connection_state_inner(keep_voip_calls).await;
         self.clear_connection_scoped_pair_code().await;
     }
 
@@ -1072,8 +1115,30 @@ impl Client {
     )]
     #[cfg(feature = "client-lifecycle")]
     pub(crate) async fn cleanup_connection_state(self: &Arc<Self>) {
+        self.cleanup_connection_state_with_voip_policy(false).await;
+    }
+
+    /// Run-loop variant; see the `#[cfg(not(feature = "client-lifecycle"))]` twin for the
+    /// classification rationale.
+    #[cfg(feature = "client-lifecycle")]
+    pub(crate) async fn cleanup_connection_state_on_transport_loss(
+        self: &Arc<Self>,
+        unexpected_disconnect: bool,
+    ) {
+        let keep_voip_calls = unexpected_disconnect
+            && self.is_running.load(Ordering::Relaxed)
+            && self.enable_auto_reconnect.load(Ordering::Relaxed);
+        self.cleanup_connection_state_with_voip_policy(keep_voip_calls)
+            .await;
+    }
+
+    #[cfg(feature = "client-lifecycle")]
+    pub(crate) async fn cleanup_connection_state_with_voip_policy(
+        self: &Arc<Self>,
+        keep_voip_calls: bool,
+    ) {
         if self.lifecycle.is_none() {
-            self.cleanup_connection_state_inner().await;
+            self.cleanup_connection_state_inner(keep_voip_calls).await;
             self.clear_connection_scoped_pair_code().await;
             return;
         }
@@ -1083,9 +1148,11 @@ impl Client {
         let client = Arc::clone(self);
         self.runtime
             .spawn(Box::pin(async move {
-                let result = std::panic::AssertUnwindSafe(client.cleanup_connection_state_inner())
-                    .catch_unwind()
-                    .await;
+                let result = std::panic::AssertUnwindSafe(
+                    client.cleanup_connection_state_inner(keep_voip_calls),
+                )
+                .catch_unwind()
+                .await;
                 let _ = completed.send(result);
             }))
             .detach();
@@ -1097,7 +1164,7 @@ impl Client {
         self.clear_connection_scoped_pair_code().await;
     }
 
-    async fn cleanup_connection_state_inner(&self) {
+    async fn cleanup_connection_state_inner(&self, keep_voip_calls: bool) {
         #[cfg(feature = "client-lifecycle")]
         let login_transition = self
             .login_transition
@@ -1146,15 +1213,20 @@ impl Client {
         #[cfg(feature = "client-lifecycle")]
         drop(login_transition);
         self.is_ready.store(false, Ordering::Relaxed);
-        // Publish the disconnected state BEFORE draining VoIP calls (it used to be cleared only after
+        // Publish the disconnected state BEFORE the voip teardown (it used to be cleared only after
         // the socket teardown below): a concurrent accept()/call() setup that finishes its async work
         // in this window must see `!is_connected()` and bail instead of registering/connecting a call
         // after this sweep.
         self.is_connected.store(false, Ordering::Release);
-        // Tear down every in-flight VoIP call: the relay socket and signaling are connection-scoped,
-        // so a call can't survive a disconnect/reconnect. Aborts each media task and clears the map.
+        // Reap every in-flight VoIP call — on TERMINAL disconnects only. On a transient transport
+        // blip the media relay (`net_conn`, a per-call UDP socket to the relay endpoint) is
+        // independent of the signaling WS: the driver holds its own relay path and the run loop
+        // reconnects under the blip, so the registry entries and media tasks stay put
+        // (`keep_voip_calls`, classified in `cleanup_connection_state_on_transport_loss`).
+        // Peer stanzas landing inside the gap are lost (no offline queue for call signaling) —
+        // accepted for ≤ a few-second blips (Task 1 findings).
         #[cfg(feature = "voip-runtime")]
-        {
+        if !keep_voip_calls {
             self.call_registry.abort_all();
             // Dormant outgoing calls (relay never arrived) live in pending_outgoing_calls, not the
             // registry, so abort_all misses them. Drain them and notify `ended` so any waiter wakes.

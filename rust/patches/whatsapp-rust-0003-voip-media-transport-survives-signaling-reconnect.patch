+    // A signaling-WS blip reaches the run loop's cleanup as an UNEXPECTED read-loop exit with the
+    // client still running and auto-reconnect enabled. The media relay (`net_conn`) is a per-call
+    // UDP socket to the relay endpoint, independent of the signaling WS, and the run loop
+    // reconnects under it (~1 s IK handshake) — so that path must NOT reap the live call: the
+    // registry entry and media task stay put, and the same engine keeps driving the call once
+    // signaling stanzas flow again. Terminal exits still reap (the disconnect() tail below).
+    #[tokio::test]
+    async fn media_transport_survives_signaling_reconnect() {
+        let client = make_client().await;
+        // The run-loop state at the cleanup call site during a genuine blip.
+        client.is_running.store(true, Ordering::SeqCst);
+        client.enable_auto_reconnect.store(true, Ordering::SeqCst);
+
+        let (_relay_tx, relay_rx) = async_channel::unbounded();
+        let sent = Arc::new(Mutex::new(Vec::new()));
+        let factory = MockFactory {
+            sent: sent.clone(),
+            relay_rx: Mutex::new(Some(relay_rx)),
+            connects: Arc::new(AtomicUsize::new(0)),
+        };
+        let (_mic_tx, mic_rx) = async_channel::unbounded::<Vec<i16>>();
+        let (spk_tx, _spk_rx) = async_channel::unbounded::<Vec<i16>>();
+
+        let handle = spawn_call(
+            &client,
+            mk_session(),
+            engine(),
+            &factory,
+            pcm_audio(Arc::new(mic_rx), Arc::new(spk_tx)),
+            None,
+        )
+        .await
+        .expect("spawn_call");
+
+        // Media is up: the driver emitted its initial STUN allocate over the relay transport.
+        for _ in 0..50 {
+            if !sent.lock().unwrap().is_empty() {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+        assert!(!sent.lock().unwrap().is_empty(), "media transport is up");
+
+        // Fire the disconnect path the read-loop error takes, classified as a transient blip.
+        client
+            .cleanup_connection_state_on_transport_loss(true)
+            .await;
+
+        assert_eq!(
+            client.call_registry().active_count(),
+            1,
+            "a transient signaling blip must not reap the live call"
+        );
+        let media_task_alive =
+            tokio::time::timeout(Duration::from_millis(200), handle.wait_ended())
+                .await
+                .is_err();
+        assert!(
+            media_task_alive,
+            "the media task must still be running across the blip (net_conn not closed)"
+        );
+
+        // Terminal disconnect (is_running -> false) must still reap the call.
+        client.disconnect().await;
+        assert_eq!(
+            client.call_registry().active_count(),
+            0,
+            "terminal disconnect reaps the call"
+        );
+        tokio::time::timeout(Duration::from_secs(2), handle.wait_ended())
+            .await
+            .expect("terminal disconnect must resolve wait_ended");
+    }
+
+    // The auto-reconnect term is not optional: an UNEXPECTED exit with auto-reconnect disabled
+    // reaches the run-loop cleanup with is_running still true (the loop breaks only after
+    // cleanup), so without this term a terminal shutdown would leak the registry entry and the
+    // open relay socket behind a dead call.
+    #[tokio::test]
+    async fn unexpected_exit_without_auto_reconnect_still_reaps_calls() {
+        let client = make_client().await;
+        client.is_running.store(true, Ordering::SeqCst);
+        client.enable_auto_reconnect.store(false, Ordering::SeqCst);
+
+        let (_relay_tx, relay_rx) = async_channel::unbounded();
+        let sent = Arc::new(Mutex::new(Vec::new()));
+        let factory = MockFactory {
+            sent: sent.clone(),
+            relay_rx: Mutex::new(Some(relay_rx)),
+            connects: Arc::new(AtomicUsize::new(0)),
+        };
+        let (_mic_tx, mic_rx) = async_channel::unbounded::<Vec<i16>>();
+        let (spk_tx, _spk_rx) = async_channel::unbounded::<Vec<i16>>();
+
+        let handle = spawn_call(
+            &client,
+            mk_session(),
+            engine(),
+            &factory,
+            pcm_audio(Arc::new(mic_rx), Arc::new(spk_tx)),
+            None,
+        )
+        .await
+        .expect("spawn_call");
+        assert_eq!(client.call_registry().active_count(), 1);
+
+        client
+            .cleanup_connection_state_on_transport_loss(true)
+            .await;
+
+        assert_eq!(
+            client.call_registry().active_count(),
+            0,
+            "unexpected exit with auto-reconnect off is terminal: the call must be reaped"
+        );
+        tokio::time::timeout(Duration::from_secs(2), handle.wait_ended())
+            .await
+            .expect("terminal reap must resolve wait_ended");
+    }
+
+    // reconnect()/reconnect_immediately() funnel into the run-loop cleanup classified Expected
+    // (unexpected=false). They are conceptually transient too, but wa-bridge never calls them
+    // mid-call (Task 1 findings), so the conservative teardown contract is preserved and pinned:
+    // an expected-exit cleanup reaps regardless of the run-loop flags.
+    #[tokio::test]
+    async fn expected_disconnect_cleanup_still_reaps_calls() {
+        let client = make_client().await;
+        client.is_running.store(true, Ordering::SeqCst);
+        client.enable_auto_reconnect.store(true, Ordering::SeqCst);
+
+        let (_relay_tx, relay_rx) = async_channel::unbounded();
+        let sent = Arc::new(Mutex::new(Vec::new()));
+        let factory = MockFactory {
+            sent: sent.clone(),
+            relay_rx: Mutex::new(Some(relay_rx)),
+            connects: Arc::new(AtomicUsize::new(0)),
+        };
+        let (_mic_tx, mic_rx) = async_channel::unbounded::<Vec<i16>>();
+        let (spk_tx, _spk_rx) = async_channel::unbounded::<Vec<i16>>();
+
+        let handle = spawn_call(
+            &client,
+            mk_session(),
+            engine(),
+            &factory,
+            pcm_audio(Arc::new(mic_rx), Arc::new(spk_tx)),
+            None,
+        )
+        .await
+        .expect("spawn_call");
+        assert_eq!(client.call_registry().active_count(), 1);
+
+        client
+            .cleanup_connection_state_on_transport_loss(false)
+            .await;
+
+        assert_eq!(
+            client.call_registry().active_count(),
+            0,
+            "expected-exit cleanup (reconnect()/reconnect_immediately() shape) reaps the call"
+        );
+        tokio::time::timeout(Duration::from_secs(2), handle.wait_ended())
+            .await
+            .expect("terminal reap must resolve wait_ended");
+    }
+
     // An attached call that ends via the media layer (relay disconnect, no <terminate> stanza) drops
     // its sibling-dismiss tracking automatically: the rung devices live on the registry session, which
     // the media task's completion path removes. No separate per-call map to leak.
@@ -6570,10 +6740,15 @@ mod tests {
         }
     }
 
-    // Finding 1: the call is registered BEFORE the relay connect().await. If cleanup_connection_state

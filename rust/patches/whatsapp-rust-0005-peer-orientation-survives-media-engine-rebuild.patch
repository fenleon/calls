@@ -2630,6 +2630,15 @@ async fn attach_engine(
     // self LID and never rekeys).
     rekey_rx: Option<async_channel::Receiver<String>>,
 ) -> Result<(), CallError> {
+    // Seed the engine from the registry's peer-orientation cell and arm the write-through: a

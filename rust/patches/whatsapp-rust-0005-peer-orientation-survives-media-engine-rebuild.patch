+    #[test]
+    fn peer_orientation_survives_engine_rebuild() {
+        use portable_atomic::AtomicU8;
+        use std::sync::Arc;
+        use std::sync::atomic::Ordering;
+
+        // The registry's cell outlives any one engine: engine 1 learns the peer rotated to 2 and
+        // writes through, so the rebuilt engine 2 seeds 2 instead of 0 — the peer camera
+        // off→on rebuild used to flash the incoming video CW-90.
+        let cell = Arc::new(AtomicU8::new(0));
+        let mut eng1 = engine(true);
+        eng1.attach_peer_orientation_cell(Some(Arc::clone(&cell)));
+        eng1.set_peer_video_orientation(2);
+        assert_eq!(cell.load(Ordering::Relaxed), 2);
+
+        // Media plane rebuilds (peer stop→start, same call + generation) → engine 2 seeds from
+        // the cell, and keeps stamping it on inbound AUs.
+        let mut eng2 = engine(true);
+        eng2.attach_peer_orientation_cell(Some(Arc::clone(&cell)));
+        assert_eq!(eng2.peer_video_orientation(), 2);
+        assert!(eng2.enable_video());
+        eng2.start(0, 0);
+        let _ = drain(&mut eng2);
+
+        let mut peer = peer_video_pipe();
+        let packets = peer.protect_video(&video_au(100));
+        for p in &packets {
+            eng2.handle_input(1, Input::RelayPacket(p));
+        }
+        assert!(drain(&mut eng2).0.iter().any(|output| matches!(
+            output,
+            Output::VideoPlayout(VideoFrame { orientation: 2, .. })
+        )));
+    }
+

@@ -1587,9 +1594,29 @@ impl CallEngine {
     }
 
     /// Record the peer's device orientation (0..3, ×90°) from a `<video>` stanza; stamped on every
-    /// subsequently reassembled inbound AU.
+    /// subsequently reassembled inbound AU. Writes through to the registry's cell when one is
+    /// attached, so a rebuilt engine seeds the last-known value instead of 0.
     pub fn set_peer_video_orientation(&mut self, orientation: u8) {
-        self.peer_video_orientation = orientation & 0x03;
+        let orientation = orientation & 0x03;
+        self.peer_video_orientation = orientation;
+        if let Some(cell) = &self.peer_orientation_cell {
+            cell.store(orientation, Ordering::Relaxed);
+        }
+    }
+
+    /// The peer's device orientation (0..3, ×90°).
+    pub fn peer_video_orientation(&self) -> u8 {
+        self.peer_video_orientation
+    }
+
+    /// Wire the registry's peer-orientation cell. Seeds from it — a media-plane rebuild (peer
+    /// stop→start on the same call generation) must inherit the peer's last-known rotation, not
+    /// flash back to 0 — and arms the write-through for every later update.
+    pub fn attach_peer_orientation_cell(&mut self, cell: Option<Arc<AtomicU8>>) {
+        if let Some(cell) = cell {
+            self.peer_video_orientation = cell.load(Ordering::Relaxed) & 0x03;
+            self.peer_orientation_cell = Some(cell);
+        }
     }
 
     /// Record orientation for one authenticated group participant/device.

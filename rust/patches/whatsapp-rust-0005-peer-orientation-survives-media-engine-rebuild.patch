+    /// Record the peer's last-known `device_orientation` (90° steps 0..3) so a rebuilt engine
+    /// seeds it instead of 0. Generation-guarded; no-op for an unknown call.
+    pub fn set_peer_video_orientation(&self, call_id: &str, generation: u64, orientation: u8) {
+        if let Some(entry) = self
+            .inner
+            .lock()
+            .expect("registry lock poisoned")
+            .get_mut(call_id)
+            && entry.generation == generation
+        {
+            entry
+                .peer_video_orientation
+                .store(orientation & 0x03, Ordering::Relaxed);
+        }
+    }
+
+    /// The peer's last-known `device_orientation` (90° steps 0..3); 0 before the peer signals one
+    /// or for an unknown call.
+    pub fn peer_video_orientation(&self, call_id: &str, generation: u64) -> u8 {
+        self.inner
+            .lock()
+            .expect("registry lock poisoned")
+            .get(call_id)
+            .filter(|entry| entry.generation == generation)
+            .map(|entry| entry.peer_video_orientation.load(Ordering::Relaxed))
+            .unwrap_or(0)
+    }
+
+    /// The peer-orientation cell to hand a [`CallEngine`] at attach: the engine seeds from it and
+    /// writes every later update through, so the last-known value outlives any one engine. `None`
+    /// for an unknown or stale call.
+    pub fn peer_video_orientation_cell(
+        &self,
+        call_id: &str,
+        generation: u64,
+    ) -> Option<Arc<AtomicU8>> {
+        self.inner
+            .lock()
+            .expect("registry lock poisoned")
+            .get(call_id)
+            .filter(|entry| entry.generation == generation)
+            .map(|entry| Arc::clone(&entry.peer_video_orientation))
+    }
+
     /// Attach the group-media control sender for this call generation.
     pub fn set_group_control_sender(
         &self,
@@ -4834,6 +4883,26 @@ mod tests {
         assert!(reg.begin_local_video_request("CID", generation).is_some());
     }
 
+    #[test]
+    fn peer_orientation_cell_is_generation_guarded() {
+        let reg = CallRegistry::new();
+        let generation = reg.insert(session("CID"));
+        assert_eq!(reg.peer_video_orientation("CID", generation), 0);
+        reg.set_peer_video_orientation("CID", generation, 2);
+        assert_eq!(reg.peer_video_orientation("CID", generation), 2);
+        // A stale or unknown call reads 0, never the current call's value.
+        assert_eq!(reg.peer_video_orientation("CID", generation + 1), 0);
+        assert_eq!(reg.peer_video_orientation("NOPE", generation), 0);
+        let cell = reg
+            .peer_video_orientation_cell("CID", generation)
+            .expect("cell for the current generation");
+        assert_eq!(cell.load(Ordering::Relaxed), 2);
+        assert!(
+            reg.peer_video_orientation_cell("CID", generation + 1)
+                .is_none()
+        );
+    }
+

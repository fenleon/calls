Subject: [PATCH] local session work 2026-09-22..24: terminate per-device
 fan-out, caller_pn revert (probe evidence), voip stanza logging, video
 device_orientation signaling

---
 src/client/voip.rs        | 58 ++++++++++++++++++++++++++++++++-------
 src/handlers/call.rs      |  1 +
 src/voip/facade.rs        | 49 ++++++++++++++++++++++++++-------
 wacore/src/stanza/call.rs | 27 ++++++++++++++----
 4 files changed, 110 insertions(+), 25 deletions(-)

diff --git a/src/client/voip.rs b/src/client/voip.rs
index ddf0d3e0..0512cc80 100644
--- a/src/client/voip.rs
+++ b/src/client/voip.rs
@@ -1821,22 +1821,60 @@ impl Voip<'_> {
         if call_id.is_empty() {
             return Err(CallError::EmptyCallId);
         }
-        let id = self.client.generate_request_id();
-        let stanza = build_terminate(&TerminateParams {
-            call_id,
-            to: peer,
-            id: Some(&id),
-            call_creator,
-            reason: None,
-        });
-        let sent = self.client.send_node(stanza).await;
+        // Call signaling routes per device: a bare-JID terminate from a companion sender
+        // reaches only the peer's PRIMARY, leaving the peer's other devices ringing a call
+        // nobody can answer (observed 2026-09-23). WA Web therefore sends one terminate per
+        // device JID (see `TerminateParams.to`). Resolve the peer's devices and fan out; on
+        // resolution failure fall back to the single bare-peer stanza (the pre-fix behavior).
+        let mut targets = match self
+            .client
+            .signal()
+            .get_user_devices(std::slice::from_ref(peer))
+            .await
+        {
+            #[cfg(feature = "voip-runtime")]
+            Ok(fetched) => crate::voip::facade::drop_hosted_devices(fetched),
+            #[cfg(not(feature = "voip-runtime"))]
+            Ok(fetched) => fetched,
+            Err(error) => {
+                log::warn!("voip: terminate peer-device resolve failed, bare fallback: {error}");
+                Vec::new()
+            }
+        };
+        if targets.is_empty() {
+            targets.push(peer.clone());
+        }
+        let mut last_error = None;
+        let mut sent_any = false;
+        for device in &targets {
+            let id = self.client.generate_request_id();
+            let stanza = build_terminate(&TerminateParams {
+                call_id,
+                to: device,
+                id: Some(&id),
+                call_creator,
+                reason: None,
+            });
+            log::info!("voip: sending terminate stanza: {stanza:?}");
+            match self.client.send_node(stanza).await {
+                Ok(()) => sent_any = true,
+                Err(error) => {
+                    log::warn!("voip: terminate to {} failed: {error}", device.observe());
+                    last_error = Some(error)
+                }
+            }
+        }
         // Tear the local call down regardless of whether the stanza reached the peer: the app asked to
         // hang up, and a failed signaling send must not leave the media task capturing/sending (or a
         // dormant outgoing call free to attach on a late relay ack). Reuse the same teardown the peer's
         // `<terminate>` triggers so the public hangup actually ends our side too.
         #[cfg(feature = "voip-runtime")]
         crate::voip::facade::terminate_call(self.client, call_id);
-        sent?;
+        if let Some(error) = last_error
+            && !sent_any
+        {
+            return Err(error.into());
+        }
         Ok(())
     }
 }

         }
-        // The upgrade INITIATOR holds outbound video until the peer accepts (the handler ungates on
-        // the peer's UpgradeAccept/Enabled). The acceptor's peer already requested, so it may send
-        // immediately.
+        // EXPERIMENT (2026-09-25 live session): the initiator used to gate outbound video until
+        // the peer's UpgradeAccept — but with the gate, the initiator's valid-H264 stream is never
+        // decoded by the official responder (PLI storm, no render, peer reverts after ~8 s), while
+        // the acceptor role (Enable from the start) decodes fine at the same peer. Ungate the
+        // initiator immediately to discriminate: if video then flows, the gate window / first-packet
+        // timing is the culprit; if not, the gap is handshake-side. Sending early costs a few AUs
+        // before the peer's state-4 — the engine drops nothing, the peer's demuxer simply joins on
+        // its first IDR.
         let ctl = match role {
-            VideoUpgradeRole::Initiate => VideoControl::EnableAwaitingAccept,
+            VideoUpgradeRole::Initiate => VideoControl::Enable,
             VideoUpgradeRole::Accept(_) => VideoControl::Enable,
         };
         self.video.send_control(ctl);

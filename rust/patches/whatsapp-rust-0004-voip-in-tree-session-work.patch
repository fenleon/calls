+    /// Share the call's outbound `device_orientation` cell (90° steps 0..3)
+    /// with the signaling handler, whose own `<video>` sends read it.
+    /// Generation-guarded; no-op for an unknown call.
+    pub fn set_device_orientation(&self, call_id: &str, generation: u64, cell: Arc<AtomicU8>) {
+        if let Some(entry) = self
+            .inner
+            .lock()
+            .expect("registry lock poisoned")
+            .get_mut(call_id)
+            && entry.generation == generation
+        {
+            entry.device_orientation = Some(cell);
+        }
+    }
+
+    /// The call's outbound `device_orientation` (90° steps 0..3); 0 before a
+    /// consumer sets it or for an unknown call.
+    pub fn device_orientation(&self, call_id: &str, generation: u64) -> u8 {
+        self.inner
+            .lock()
+            .expect("registry lock poisoned")
+            .get(call_id)
+            .filter(|entry| entry.generation == generation)
+            .and_then(|entry| entry.device_orientation.as_deref())
+            .map(|cell| cell.load(Ordering::Relaxed))
+            .unwrap_or(0)
+    }

+        let reg = CallRegistry::new();
+        let generation = reg.insert(session("CID"));
+        // set_video_channels runs at registration for every call (audio
+        // included) and installs a teardown hook — it must NOT read as a
+        // live plane. Only the endpoint attach (set_video_teardown) does.

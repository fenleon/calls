+    // Peer re-ICE on an ACTIVE 1:1 call (network switch): the peer expects a type-9 transport
+    // reply, and our own relay path must be rebuilt — ignoring the re-ICE is fatal (the peer
+    // gives up ~5s later). Regression for the on-device mid-call network-toggle wedge.
+    #[cfg(feature = "voip-runtime")]
+    #[tokio::test]
+    async fn peer_reice_on_active_call_replies_and_rebuilds_relay() {
+        use wacore::voip::VideoControl;
+
+        let client = make_sending_client().await;
+        let registry = client.call_registry();
+        let session = wacore::voip::CallSession::new_incoming(
+            "CALL-ID-0001",
+            fake_caller_lid(),
+            fake_caller_lid(),
+        );
+        let generation = registry.insert(session);
+        let (ev_tx, _ev_rx) = async_channel::unbounded::<CallEvent>();
+        let (ctl_tx, ctl_rx) = video_control_channel();
+        registry.set_video_channels("CALL-ID-0001", generation, ev_tx, ctl_tx, Box::new(|| {}));
+        let reply_waiter = client.wait_for_sent_node(crate::client::NodeFilter::tag("call"));
+
+        let stanza = NodeBuilder::new("call")
+            .attr("from", fake_caller_lid())
+            .attr("id", "STANZA-REICE")
+            .attr("t", "1766847151")
+            .children([NodeBuilder::new("transport")
+                .attr("call-creator", fake_caller_lid())
+                .attr("call-id", "CALL-ID-0001")
+                .attr("transport-message-type", "3")
+                .build()])
+            .build();
+        let mut cancelled = false;
+        assert!(
+            CallHandler
+                .handle(client, node_to_owned_ref(&stanza), &mut cancelled)
+                .await
+        );
+
+        let reply = tokio::time::timeout(std::time::Duration::from_secs(2), reply_waiter)
+            .await
+            .expect("the type-9 transport reply must be sent")
+            .expect("waiter");
+        let reply_ref = reply.as_node_ref();
+        let children = reply_ref.children().expect("transport child");
+        let transport = &children[0];
+        assert_eq!(transport.tag, "transport");
+        assert_eq!(
+            transport
+                .attrs()
+                .optional_string("transport-message-type")
+                .as_deref(),
+            Some("9"),
+            "a peer re-ICE (type 3) is answered with a type-9 transport reply"
+        );
+        assert_eq!(
+            transport.attrs().optional_string("call-id").as_deref(),
+            Some("CALL-ID-0001")
+        );
+        let net = transport.get_optional_child("net").expect("net child");
+        assert!(
+            net.attrs().optional_string("protocol").is_none(),
+            "a type-9 reply omits the net protocol attribute"
+        );
+
+        let ctls: Vec<VideoControl> = std::iter::from_fn(|| ctl_rx.try_recv().ok()).collect();
+        assert!(
+            ctls.contains(&VideoControl::RebuildRelay),
+            "the media engine must be poked to rebuild the relay path"
+        );
+        registry.remove_if_current("CALL-ID-0001", generation);
+    }
+
+    // The group path keeps its own relay refresh machinery: a transport type-3 on a group call
+    // must NOT produce the 1:1 type-9 reply nor poke the 1:1 video control plane.
+    #[cfg(feature = "voip-runtime")]
+    #[tokio::test]
+    async fn peer_reice_on_group_call_keeps_the_group_path() {
+        use wacore::voip::VideoControl;
+
+        let client = make_sending_client().await;
+        let registry = client.call_registry();
+        let creator = fake_caller_lid();
+        let generation = registry.insert_group(wacore::voip::CallSession::new_outgoing(
+            "GROUP-CALL",
+            Jid::new("GROUP-CALL", Server::Call),
+            creator.clone(),
+        ));
+        assert!(registry.is_group_call("GROUP-CALL"));
+        let (ev_tx, _ev_rx) = async_channel::unbounded::<CallEvent>();
+        let (ctl_tx, ctl_rx) = video_control_channel();
+        registry.set_video_channels("GROUP-CALL", generation, ev_tx, ctl_tx, Box::new(|| {}));
+        let reply_waiter = client.wait_for_sent_node(crate::client::NodeFilter::tag("call"));
+
+        let stanza = NodeBuilder::new("call")
+            .attr("from", Jid::new("GROUP-CALL", Server::Call))
+            .attr("id", "STANZA-GROUP-REICE")
+            .attr("t", "1766847151")
+            .children([NodeBuilder::new("transport")
+                .attr("call-creator", creator)
+                .attr("call-id", "GROUP-CALL")
+                .attr("transport-message-type", "3")
+                .build()])
+            .build();
+        let mut cancelled = false;
+        assert!(
+            CallHandler
+                .handle(client, node_to_owned_ref(&stanza), &mut cancelled)
+                .await
+        );
+
+        // A matching send always resolves the waiter with the node; Elapsed or a canceled
+        // waiter both mean no call-tag stanza went out.
+        if let Ok(Ok(node)) =
+            tokio::time::timeout(std::time::Duration::from_millis(500), reply_waiter).await
+        {
+            panic!(
+                "a group call must not get the 1:1 type-9 transport reply; sent: {:?}",
+                node.as_node_ref()
+            );
+        }
+        let ctls: Vec<VideoControl> = std::iter::from_fn(|| ctl_rx.try_recv().ok()).collect();
+        assert!(
+            !ctls.contains(&VideoControl::RebuildRelay),
+            "group relay refresh stays on the group roster path"
+        );
+        registry.remove_if_current("GROUP-CALL", generation);
+    }

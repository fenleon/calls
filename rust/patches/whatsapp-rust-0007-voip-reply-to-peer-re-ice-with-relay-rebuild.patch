+    /// Peer-driven 1:1 relay rebuild (a re-ICE after a network switch): retire the transport and
+    /// re-allocate on the stored credentials. Mirrors the relay-refresh tail of
+    /// [`commit_group_allocate`] — the driver redials on `Output::ReconnectRelay`, sends the
+    /// retained allocate over the replacement channel, and `relay_reconnected` arms the response
+    /// budget once the new transport is up. Inert before `start` or after a terminal failure.
+    pub fn rebuild_relay(&mut self) {
+        if self.terminated || !self.started {
+            return;
+        }
+        self.allocated = false;
+        self.allocate_pending = true;
+        self.allocate_deadline = NEVER;
+        self.outbox
+            .push_back(Output::ReconnectRelay(self.relay_addr));
+        self.outbox
+            .push_back(Output::Transmit(self.allocate.clone()));
+    }
+
     /// Start the deferred allocation-response budget once a replacement relay transport is ready.
     pub(crate) fn relay_reconnected(&mut self, now: Millis) {
         if self.started && self.allocate_pending && self.allocate_deadline == NEVER {
@@ -3812,6 +3830,71 @@ mod encoded_tests {
         );
     }
 
+    fn one_to_one_engine() -> CallEngine {
+        CallEngine::new(config(), Box::new(SequentialTxIds::new())).unwrap()
+    }
+
+    // A peer re-ICE on a 1:1 call (network switch) retires the relay path on the SAME
+    // credentials: the driver redials the stored endpoint, then the retained allocate binds the
+    // replacement socket. Mirrors the group relay-refresh tail of `commit_group_allocate`.
+    #[test]
+    fn one_to_one_rebuild_relay_redials_before_reallocating() {
+        let mut engine = one_to_one_engine();
+        engine.start(0, 1_700_000_000_000);
+        let _ = drain(&mut engine);
+        let success = allocation_success(&engine);
+        engine.handle_input(1, Input::RelayPacket(&success));
+        let _ = drain(&mut engine);
+        assert!(engine.is_allocated());
+
+        engine.rebuild_relay();
+
+        let outputs = drain(&mut engine);
+        let reconnect_index = outputs
+            .iter()
+            .position(|output| {
+                matches!(output, Output::ReconnectRelay(endpoint) if *endpoint == engine.relay_addr)
+            })
+            .expect("reconnect intent on the configured relay endpoint");
+        let allocate_index = outputs
+            .iter()
+            .position(|output| matches!(output, Output::Transmit(_)))
+            .expect("replacement allocate");
+        assert!(
+            reconnect_index < allocate_index,
+            "the shell must redial before sending the replacement allocate"
+        );
+        assert!(
+            !engine.is_allocated(),
+            "the old allocation died with the retired socket"
+        );
+        assert_eq!(
+            engine.allocate_deadline, NEVER,
+            "the reconnect handshake must not consume the allocation response budget"
+        );
+        engine.relay_reconnected(14_000);
+        assert_ne!(
+            engine.allocate_deadline, NEVER,
+            "the replacement allocation retains its full response budget after reconnect"
+        );
+    }
+
+    #[test]
+    fn one_to_one_rebuild_relay_is_inert_before_start_or_after_terminal_failure() {
+        let mut engine = one_to_one_engine();
+        engine.rebuild_relay();
+        assert!(drain(&mut engine).is_empty(), "not started yet");
+
+        engine.start(0, 1_700_000_000_000);
+        let _ = drain(&mut engine);
+        engine.terminated = true;
+        engine.rebuild_relay();
+        assert!(
+            drain(&mut engine).is_empty(),
+            "a terminal engine emits nothing further"
+        );
+    }

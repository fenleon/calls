<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <provider
            android:name=".ServerBootstrapProvider"
            android:authorities="com.lightphone.calls.server.bootstrap"
            android:exported="false" />

        <!-- Persistent WhatsApp WebSocket (no GMS — the socket is the push channel). -->
        <service
            android:name=".WaSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Restart that socket after boot / package update (both are
             protected system broadcasts — only the system can send them). -->
        <receiver
            android:name=".WaBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Fronts an active call (mic + camera capture while
             foreground-visible). Both while-in-use types are declared; the
             type set passed to startForeground is the granted subset —
             camera only joins once CAMERA is granted (Android 14 throws
             SecurityException otherwise), so audio-only calls run
             microphone-only. -->
        <service
            android:name=".WaCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- AOSP runtime-permission host for the SDK permission flow (the
             screens request RECORD_AUDIO through it). Translucent so the
             system dialog is the only thing visible. -->
        <activity
            android:name=".WaPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
